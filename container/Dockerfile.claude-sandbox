# ARCHIVED — DO NOT BUILD OR DEPLOY
#
# This Dockerfile is intentionally non-operational. It is kept for historical
# reference but must not be used. See the architectural note below.
#
# --- Architectural finding (EPIC-038 OAuth2 review) ---
#
# The claude CLI authenticates via OAuth2 session tokens stored in ~/.claude/.
# To run the CLI inside a container, ~/.claude/ would need to be bind-mounted
# into the container, concentrating long-lived credential material inside the
# container boundary. Any image escape, snapshot leak, or containerd storage
# compromise would expose those tokens.
#
# Additionally, the primary threat model for claude invocations is prompt
# injection — a language-layer attack where adversarial content in the model's
# input or output causes unintended behaviour. gVisor's value is syscall
# interposition. It cannot detect or prevent a model from exfiltrating context
# in natural-language output. The sandbox boundary provides no mitigation for
# prompt injection; it only adds container lifecycle latency and CRI complexity.
#
# Decision: InvokeClaudeSubprocess is routed through LocalRuntime unconditionally
# via HybridRuntime in runtime.go. The claude CLI runs as a local subprocess,
# with its existing ~/.claude/ credential store intact. ffmpeg and whisper
# continue to run in gVisor containers (no credential exposure, syscall attack
# surface reduction is meaningful for binary media processing).
#
# --- Original intent (EPIC-038 M2) ---
# Alpine image with the claude CLI binary (Claude Code CLI).
# Claude requires outbound HTTPS to api.anthropic.com — NetworkPolicy=host.
# API key injected at runtime via ANTHROPIC_API_KEY; never baked in.

FROM alpine:3.21 AS base
# Build-time guard: fail immediately if anyone attempts to build this image.
# This Dockerfile is archived and must never be built. EPIC-089 M5.
RUN false

# The claude CLI binary is a self-contained Node.js bundle — no Node runtime
# needed after bundling. Copy from host path supplied at build time.
ARG CLAUDE_BIN_PATH
COPY "${CLAUDE_BIN_PATH}" /usr/local/bin/claude
RUN chmod 755 /usr/local/bin/claude

FROM alpine:3.21

# glibc compat shim — the claude CLI bundle expects glibc on Linux.
RUN apk add --no-cache libc6-compat

COPY --from=base /usr/local/bin/claude /usr/local/bin/claude

# I/O: system prompt file is mounted read-only at /linkari/io/system_prompt.txt;
# content (stdin) is piped to the container's stdin by ContainerRuntime.
RUN mkdir -p /linkari/io
VOLUME ["/linkari/io"]

# API key must be set at container start — fail fast if absent.
# ContainerRuntime.InvokeClaudeSubprocess resolves ANTHROPIC_API_KEY from
# the host environment and forwards it as a container env var.
ENV ANTHROPIC_API_KEY=""

# Session persistence is disabled: each container invocation is stateless.
# --no-session-persistence prevents writes to ~/.claude/ inside the container.
ENV CLAUDE_NO_SESSION_PERSISTENCE=1

RUN addgroup -g 1000 linkari && adduser -u 1000 -G linkari -s /bin/sh -D linkari
USER linkari

ENTRYPOINT ["/usr/local/bin/claude"]
