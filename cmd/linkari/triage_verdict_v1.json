{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TriageVerdict",
  "description": "Linkari triage v1 — typed contract for Haiku-scored link verdicts (EPIC-044 M1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["score", "verdict", "rubric_scores"],
  "properties": {
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Total score across all rubric axes."
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "One-paragraph verdict for the link."
    },
    "action_items": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 120},
      "maxItems": 5
    },
    "tags": {
      "type": "string",
      "description": "Comma-separated tag list."
    },
    "topic_tags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "maxItems": 10,
      "description": "2-10 lowercase topic keyword tags for clustering."
    },
    "action_route": {
      "type": "string",
      "enum": ["draft_jira_ticket", "append_research_digest", ""],
      "description": "Optional action route for high-confidence scores."
    },
    "rubric_scores": {
      "type": "object",
      "description": "Per-axis scores keyed by axis name from the profile manifest.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      }
    },
    "profile": {"type": "string"},
    "profile_version": {"type": "integer", "minimum": 1}
  }
}
